# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.Python
venv/
.venv/
env/
ENV/
.python-version

# --- Tooling / caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Node / Next.js ---
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
*.log

# --- Generated data (large, reproducible) ---
# NOTE: data/manifests/ is intentionally NOT ignored - manifests are small
# metadata files and should be tracked as part of the project record.
data/bronze/
data/silver/
data/gold/
data/quarantine/
*.duckdb
*.duckdb.wal
*.parquet

# Keep the data directory itself but not generated payloads.
!data/manifests/
!data/manifests/.gitkeep

# --- Playwright / e2e ---
playwright-report/
test-results/
playwright/.cache/
blob-report/

# --- Local verification / logs (outside-repo logs may also exist at workspace root) ---
verification_logs/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
