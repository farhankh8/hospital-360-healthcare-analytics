# HOSPITAL 360 - FastAPI analytics backend
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    DATA_PATH=/app/data \
    DATABASE_PATH=/app/data/hospital360.duckdb

WORKDIR /app

# System deps for DuckDB / pandas wheels and health-check utility.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Source layers required by the API at runtime.
COPY generator/ ./generator/
COPY etl/ ./etl/
COPY analytics/ ./analytics/
COPY api/ ./api/

# Persistent data volume mount point. Generated files are expected in ./data.
RUN mkdir -p /app/data /app/data/bronze /app/data/silver /app/data/gold \
             /app/data/quarantine /app/data/manifests

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8000/api/v1/health || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
